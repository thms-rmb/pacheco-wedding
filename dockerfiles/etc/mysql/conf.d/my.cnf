[mysqld]
bind-address = 0.0.0.0

# MySQL runs as one mysqld process; these settings control the connection and
# worker-thread concurrency available.
max_connections = 128
thread_cache_size = 32
innodb_thread_concurrency = 0
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# Memory and cache sizing. Keep this comfortably below the memory available to
# the db container, especially when increasing max_connections.
innodb_buffer_pool_size = 512M
table_open_cache = 2000
tmp_table_size = 64M
max_heap_table_size = 64M

# Redo log and durability. Changing innodb_flush_log_at_trx_commit from 1 can
# improve write throughput, but weakens crash durability.
innodb_redo_log_capacity = 256M
innodb_flush_log_at_trx_commit = 1
