#!/usr/bin/env bash

set -euo pipefail

target="wp-files"
content_dir="${target}/wp-content"
host_user="${SUDO_USER:-${USER}}"
host_uid="$(id -u "${host_user}")"
www_data_gid=33

chown -R "${host_uid}:${www_data_gid}" "${target}"

find "${target}" -type d -exec chmod 0775 {} +
find "${content_dir}" -type d -exec chmod g+s {} +
find "${target}" -type f -exec chmod 0664 {} +
